{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pasupasastra GCS",
  "version": "0.2.0",
  "identifier": "id.darmawanrobotics.pasupasastra",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pasupasastra",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Ground control station multi-drone",
    "longDescription": "pasupasastra - Unified Command Center For Multi-drone Operations",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
